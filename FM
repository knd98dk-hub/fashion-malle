<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>LUXE BEAUTÉ | Premium Cosmetics for Queens</title>
  <meta name="description" content="Discover luxury makeup that makes you feel like royalty. Cruelty-free • Vegan • Long-lasting • Made for Queens 👑"/>

  <!-- Favicon -->
  <link rel="icon" href="https://fav.farm/💄" type="image/svg+xml">

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>

  <style>
    :root {
      --pink: #ff5e8e;
      --gold: #d4af37;
      --dark: #1a1a1a;
      --light-pink: #fff0f5;
      --white: #ffffff;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Poppins', sans-serif;
      background: var(--white);
      color: var(--dark;
      overflow-x: hidden;
    }

    /* Smooth scroll */
    html { scroll-behavior: smooth; }

    /* Navbar */
    .navbar {
      position: fixed;
      top: 0;
      width: 100%;
      padding: 20px 8%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(255,255,255,0.95);
      backdrop-filter: blur(10px);
      z-index: 1000;
      transition: 0.4s;
    }

    .navbar.scrolled {
      padding: 15px 8%;
      background: rgba(255,255,255,0.98);
      box-shadow: 0 5px 20px rgba(0,0,0,0.05);
    }

    .logo {
      font-family: 'Playfair Display', serif;
      font-size: 2.2rem;
      font-weight: 700;
      color: var(--pink);
      text-decoration: none;
    }

    .logo span { color: var(--gold); }

    .nav-links a {
      margin-left: 35px;
      text-decoration: none;
      color: var(--dark);
      font-weight: 500;
      transition: 0.3s;
    }

    .nav-links a:hover { color: var(--pink); }

    /* Hero Section */
    .hero {
      height: 100vh;
      background: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.6)), url('https://images.unsplash.com/photo-1591370871770-3249f20e8b0d?ixlib=rb-4.0.3&auto=format&fit=crop&w=2850&q=90') center/cover no-repeat;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: white;
      position: relative;
    }

    .hero::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 200px;
      background: linear-gradient(transparent, var(--white));
    }

    .hero-content {
      max-width: 800px;
      padding: 0 20px;
      animation: fadeInUp 1.2s ease;
    }

    .hero h1 {
      font-family: 'Playfair Display', serif;
      font-size: 4.5rem;
      margin-bottom: 20px;
      line-height: 1.1;
    }

    .hero p {
      font-size: 1.3rem;
      margin-bottom: 40px;
      opacity: 0.9;
    }

    .btn {
      padding: 16px 40px;
      background: var(--pink);
      color: white;
      border: none;
      border-radius: 50px;
      font-size: 1.1rem;
      font-weight: 600;
      cursor: pointer;
      transition: 0.4s;
      text-decoration: none;
      display: inline-block;
      box-shadow: 0 10px 30px rgba(255,94,142,0.3);
    }

    .btn:hover {
      background: #ff3a70;
      transform: translateY(-5px);
      box-shadow: 0 20px 40px rgba(255,94,142,0.4);
    }

    .btn-outline {
      background: transparent;
      border: 2px solid white;
      margin-left: 15px;
    }

    .btn-outline:hover {
      background: white;
      color: var(--pink);
    }

    /* Features */
    .features {
      padding: 120px 8%;
      background: var(--light-pink);
      text-align: center;
    }

    .section-title {
      font-family: 'Playfair Display', serif;
      font-size: 3rem;
      text-align: center;
      margin-bottom: 80px;
      color: var(--dark);
    }

    .feature-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 40px;
      max-width: 1200px;
      margin: 0 auto;
    }

    .feature-card {
      background: white;
      padding: 40px 30px;
      border-radius: 20px;
      text-align: center;
      box-shadow: 0 10px 30px rgba(0,0,0,0.05);
      transition: 0.4s;
    }

    .feature-card:hover {
      transform: translateY(-15px);
      box-shadow: 0 25px 50px rgba(255,94,142,0.15);
    }

    .feature-card i {
      font-size: 3rem;
      color: var(--pink);
      margin-bottom: 20px;
    }

    /* Products Showcase */
    .products {
      padding: 120px 8%;
      background: white;
    }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 40px;
      max-width: 1400px;
      margin: 0 auto;
    }

    .product-card {
      position: relative;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 15px 40px rgba(0,0,0,0.1);
      transition: 0.4s;
    }

    .product-card:hover {
      transform: scale(1.05);
    }

    .product-card img {
      width: 100%;
      height: 420px;
      object-fit: cover;
    }

    .product-info {
      position: absolute;
      bottom: 0;
      left: 0;
      background: linear-gradient(transparent, rgba(0,0,0,0.8));
      color: white;
      padding: 30px;
      width: 100%;
    }

    .badge {
      position: absolute;
      top: 20px;
      right: 20px;
      background: var(--gold);
      color: white;
      padding: 8px 16px;
      border-radius: 30px;
      font-size: 0.9rem;
      font-weight: 600;
    }

    /* Testimonials */
    .testimonials {
      padding: 120px 8%;
      background: linear-gradient(135deg, #fff0f5 0%, #fce8ef 100%);
      text-align: center;
    }

    .testimonial-card {
      max-width: 700px;
      margin: 0 auto;
      font-size: 1.4rem;
      font-style: italic;
      color: #555;
      line-height: 1.8;
    }

    .author {
      margin-top: 30px;
      font-weight: 600;
      color: var(--pink);
    }

    /* Footer */
    footer {
      background: var(--dark);
      color: white;
      padding: 80px 8% 30px;
      text-align: center;
    }

    .social-links a {
      color: white;
      font-size: 1.8rem;
      margin: 0 15px;
      transition: 0.3s;
    }

    .social-links a:hover {
      color: var(--pink);
      transform: translateY(-5px);
    }

    /* Animations */
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(50px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Mobile */
    @media (max-width: 768px) {
      .hero h1 { font-size: 3.2rem; }
      .hero p { font-size: 1.1rem; }
      .nav-links { display: none; } /* Add hamburger menu if needed */
      .navbar { padding: 15px 5%; }
      .btn { display: block; margin: 15px auto; }
      .btn-outline { margin-left: 0; }
    }
  </style>
</head>
<body>

  <!-- Navbar -->
  <nav class="navbar" id="navbar">
    <a href="#" class="logo">LUXE<span>BEAUTÉ</span></a>
    <div class="nav-links">
      <a href="#home">Home</a>
      <a href="#products">Products</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
    </div>
  </nav>

  <!-- Hero -->
  <section class="hero" id="home">
    <div class="hero-content">
      <h1>Be Your Own Kind<br>of Beautiful</h1>
      <p>Luxury cosmetics crafted for queens who dare to shine. Cruelty-free • Vegan • Made with love in Paris & Dubai</p>
      <a href="#products" class="btn">Shop Collection</a>
      <a href="#about" class="btn btn-outline">Our Story</a>
    </div>
  </section>

  <!-- Features -->
  <section class="features">
    <h2 class="section-title">Why Queens Choose Us</h2>
    <div class="feature-grid">
      <div class="feature-card">
        <i class="fas fa-spa"></i>
        <h3>100% Cruelty-Free</h3>
        <p>We love animals more than makeup. Always have, always will.</p>
      </div>
      <div class="feature-card">
        <i class="fas fa-leaf"></i>
        <h3>Vegan & Clean</h3>
        <p>No parabens, sulfates, or nasty chemicals. Just pure luxury.</p>
      </div>
      <div class="feature-card">
        <i class="fas fa-clock"></i>
        <h3>24H Goddess Wear</h3>
        <p>Stay flawless from sunrise coffee to midnight parties.</p>
      </div>
    </div>
  </section>

  <!-- Products -->
  <section class="products" id="products">
    <h2 class="section-title">Best Sellers</h2>
    <div class="product-grid">
      <div class="product-card">
        <span class="badge">BEST SELLER</span>
        <img src="https://images.unsplash.com/photo-1617897903355-12b07d6f7e66?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Lipstick">
        <div class="product-info">
          <h3>Velvet Rose Lipstick</h3>
          <p>$49 • 12 dreamy shades</p>
        </div>
      </div>
      <div class="product-card">
        <span class="badge">NEW</span>
        <img src="https://images.unsplash.com/photo-1596462502275-7a1b3e7.html?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Palette">
        <div class="product-info">
          <h3>Queen Palette</h3>
          <p>$79 • Limited Edition</p>
        </div>
      </div>
      <div class="product-card">
        <span class="badge">SOLD OUT SOON</span>
        <img src="https://images.unsplash.com/photo-1625772299848-391b6a87d7b3?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Highlighter">
        <div class="product-info">
          <h3>Diamond Glow Highlighter</h3>
          <p>$65 • Shine like a diamond</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonial -->
  <section class="testimonials">
    <h2 class="section-title">Queens Love Us</h2>
    <div class="testimonial-card">
      <p>"This is the ONLY lipstick that stays on through dinner, drinks, and dancing. I'm obsessed! The packaging is pure luxury too!"</p>
      <div class="author">— Sophia K., Dubai</div>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <div class="social-links">
      <a href="#"><i class="fab fa-instagram"></i></a>
      <a href="#"><i class="fab fa-tiktok"></i></a>
      <a href="#"><i class="fab fa-youtube"></i></a>
    </div>
    <p style="margin-top: 40px; opacity: 0.7;">© 2025 LUXE BEAUTÉ • Made for Queens Worldwide</p>
  </footer>

  <script>
    >
    // Navbar scroll effect
    window.addEventListener('scroll', () => {
      const navbar = document.getElementById('navbar');
      if (window.scrollY > 50) {
        navbar.classList.add('scrolled');
      } else {
        navbar.classList.remove('scrolled');
      }
    });
  </script>
</body>
</html>
